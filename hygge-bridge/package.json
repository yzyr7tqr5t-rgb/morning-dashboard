{
  "name": "hygge-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Toont de temperatuur van Niko Home Control en bedient de Seitron Hygge (via Hygge Way en IFTTT) vanaf een webpagina.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "demo": "DEMO=true node src/index.js",
    "devices": "node --env-file=.env src/list-devices.js",
    "test": "node --test"
  },
  "dependencies": {
    "mqtt": "^5.16.0"
  }
}
