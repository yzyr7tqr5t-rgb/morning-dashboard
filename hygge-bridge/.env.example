# --- Niko Home Control II (Hobby API) ---------------------------------------
# IP-adres van de Connected Controller op je thuisnetwerk
NIKO_HOST=192.168.1.50
NIKO_PORT=8884
NIKO_USERNAME=hobby
# JWT-token uit mynikohomecontrol.niko.eu (Hobby API activeren, 1 jaar geldig)
NIKO_TOKEN=plak-hier-je-hobby-api-token
# Welke sensor tonen? Geef de naam zoals in de Niko-programmeersoftware OF de UUID.
# Tip: `npm run devices` toont alle toestellen met een temperatuur.
NIKO_SENSOR_NAME=Woonkamer
NIKO_SENSOR_UUID=

# --- Seitron Hygge Way via IFTTT --------------------------------------------
# Sleutel van de IFTTT Webhooks-service (https://ifttt.com/maker_webhooks/settings)
IFTTT_KEY=plak-hier-je-ifttt-webhooks-key
# Event voor applet "Webhooks -> Seitron Smart: Set temperature" (setpoint in value1)
IFTTT_EVENT_SET_TEMPERATURE=hygge_set_temperature
# Event voor applet "Webhooks -> Seitron Smart: Switch to scheduled mode"
IFTTT_EVENT_AUTO=hygge_auto

# --- Hygge (alles in °C) ------------------------------------------------------
# Temperatuur die de pagina voorstelt zolang je nog niets gekozen hebt
DEFAULT_SETPOINT=20
# Laagste en hoogste temperatuur die je via de pagina kunt kiezen
MIN_SETPOINT=10
MAX_SETPOINT=28

# true = niets naar IFTTT sturen, enkel loggen
DRY_RUN=false

# --- Webpagina -----------------------------------------------------------------
# Open op je gsm http://<ip-van-deze-computer>:8080 (alleen in je thuisnetwerk!)
WEB_PORT=8080
